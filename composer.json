{
  "name": "webman-app/admin",
  "type": "project",
  "license": "MIT",
  "description": "Webman Admin",
  "require": {
    "php": ">=8.4",
    "workerman/webman-framework": "^2.0",
    "webman/database": "^2.0",
    "webman/event": "^1.0",
    "webman/captcha": "^1.0",
    "composer/composer": "^2.0",
    "illuminate/view": "^13.0",
    "illuminate/pagination": "^13.0",
    "intervention/image": "^4.0",
    "guzzlehttp/guzzle": "^7.0",
    "laravel/serializable-closure": "^2.0",
    "webman/console": "^2.0",
    "ext-json": "*",
    "ext-zip": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "autoload": {
    "psr-4": {
      "Webman\\Admin\\": "src",
      "Jenssegers\\Blade\\": "src/blade/"
    }
  },
  "replace": {
    "webman/blade": "self.version"
